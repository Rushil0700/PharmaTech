          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE status WHEN 'EXPIRED' THEN 'Expired' WHEN 'CRITICAL' THEN 'Under 30 days'\n                   WHEN 'WARNING' THEN '30–90 days' ELSE 'Over 90 days' END AS status,\n       SUM(stock_value) AS value\nFROM v_batch_expiry WHERE quantity_available > 0\nGROUP BY status ORDER BY MIN(days_to_expiry)"
        }
