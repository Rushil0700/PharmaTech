    {
      "type": "barchart",
      "title": "Stock value expiring per week (next 13 weeks)",
      "description": "How much money is about to expire. Sell, discount or return these first.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharmatrack-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharmatrack-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(w.week, 'DD Mon') AS \"Week of\",\n       COALESCE(SUM(e.stock_value), 0) AS \"Value at cost\"\nFROM generate_series(date_trunc('week', pharma_today()), date_trunc('week', pharma_today()) + interval '12 weeks', interval '1 week') AS w(week)\nLEFT JOIN v_batch_expiry e\n       ON date_trunc('week', e.expiry_date) = w.week AND e.quantity_available > 0 AND e.expiry_date >= pharma_today()\nGROUP BY w.week\nORDER BY w.week"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "color": {
            "mode": "fixed",
            "fixedColor": "#d98a00"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Week of",
        "orientation": "vertical",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 8
    },
    {
      "type": "piechart",
      "title": "Expiry status of stock (by value)",
      "description": "",
      "gridPos": {
