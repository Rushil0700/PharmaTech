# Copy to .env and change every "change-me" value before running:
#   cp .env.example .env

# ---------------------------------------------------------------- database
POSTGRES_DB=pharmatrack
POSTGRES_USER=pharmatrack
POSTGRES_PASSWORD=change-me-db-password
# Read-only account Grafana uses to query PostgreSQL
GRAFANA_DB_PASSWORD=change-me-grafana-reader

# ---------------------------------------------------------------- django
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
DJANGO_DEBUG=false
# Load demo medicines, batches, 90 days of sales and demo users on first start
SEED_DEMO_DATA=true

# ---------------------------------------------------------------- public address
# Local:              PUBLIC_URL=http://localhost:8080
# Cloudflare Tunnel:  PUBLIC_URL=https://pharma.yourdomain.com
PUBLIC_URL=http://localhost:8080
# Comma-separated hostnames Django accepts (add your domain when publishing)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
HTTP_PORT=8080

# ---------------------------------------------------------------- grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# true = anyone who can reach /grafana can view dashboards without logging in
# (handy for a classroom demo on localhost; keep false on a public domain)
GRAFANA_ANONYMOUS_VIEWER=false

# Email alerts (Gmail: use an App Password, not your normal password)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=you@example.com

# ---------------------------------------------------------------- cloudflare tunnel
# Zero Trust dashboard -> Networks -> Tunnels -> Create -> copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- demo traffic
SIMULATOR_INTERVAL=8
